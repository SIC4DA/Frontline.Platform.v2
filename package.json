{
  "name": "next-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start --turbopack",
    "lint": "next lint",
    "format": "bun prettier -w .",
    "auth:gen": "bunx @better-auth/cli generate --config ./src/lib/auth.ts --output=./src/core/db/schemas/auth.ts --y",
    "db:push": "bun drizzle-kit push",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:studio": "bun drizzle-kit studio",
    "cy:open": "cypress open",
    "ci": "start-server-and-test start http://localhost:3000 cy:open",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\"",
    "component": "cypress open --component",
    "component:headless": "cypress run --component"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ],
    "endOfLine": "crlf",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "printWidth": 120,
    "trailingComma": "all",
    "tabWidth": 2,
    "importOrder": [
      "^@/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.12",
    "@ai-sdk/openai": "^1.3.16",
    "@ai-sdk/react": "^1.2.9",
    "@radix-ui/react-dialog": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.0",
    "@sentry/nextjs": "^9.27.0",
    "@t3-oss/env-nextjs": "^0.13.4",
    "@tanstack/react-query": "^5.74.4",
    "@types/next": "^9.0.0",
    "ai": "^4.3.9",
    "better-auth": "1.2.7",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.6.0",
    "clsx": "^2.1.1",
    "company-email-validator": "^1.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.42.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.503.0",
    "motion": "^12.7.4",
    "next": "^15.3.2",
    "next-intl": "^4.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-speakup": "^1.1.2",
    "redis": "^4.7.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vercel": "^42.1.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/eslint-plugin-query": "^5.73.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "cypress": "^14.4.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "15.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "start-server-and-test": "^2.0.12",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}